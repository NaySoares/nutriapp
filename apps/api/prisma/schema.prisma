generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FormulaPadrao {
  mifflin
  harris_benedict
}

enum Sexo {
  M
  F
}

enum FonteAlimento {
  taco
  usda
  manual
}

enum CategoriaRefeicao {
  cafe_da_manha
  lanche
  almoco
  jantar
  ceia
  outro
}

enum TipoRefeicao {
  preparada
  composta
}

enum Locais {
  consultorio
  online
  hospital
}

enum StatusAgendamento {
  confirmada
  aguardando_confirmacao
  concluida
  falta
  cancelada
}

enum Atendimentos {
  particular
  hospitalar
}

enum TiposConsulta {
  consulta_de_retorno
  avaliacao_nutricional
  acompanhamento
  revisao_de_plano
  primeira_consulta
}

enum StatusPaciente {
  ativo
  retorno_pendente
  inativo
}

model Nutricionista {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique
  senhaHash        String            @map("senha_hash")
  nome             String
  crn              String?
  logoPath         String?           @map("logo_path")
  formulaPadrao    FormulaPadrao     @default(mifflin) @map("formula_padrao")
  fatoresAtividade Json              @map("fatores_atividade")
  criadoEm         DateTime          @default(now()) @map("criado_em")
  atualizadoEm     DateTime          @updatedAt @map("atualizado_em")
  sessoes          Sessao[]
  resetsSenha      ResetSenha[]
  pacientes        Paciente[]
  consentimentos   Consentimento[]
  auditorias       AuditoriaAcesso[]
  agendamentos     Agendamento[]
  alimentos        Alimento[]
  refeicoes        Refeicao[]

  @@map("nutricionistas")
}

model Sessao {
  id               String        @id @default(uuid()) @db.Uuid
  nutricionistaId  String        @map("nutricionista_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash")
  expiraEm         DateTime      @map("expira_em")
  revogadaEm       DateTime?     @map("revogada_em")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  atualizadoEm     DateTime      @updatedAt @map("atualizado_em")
  nutricionista    Nutricionista @relation(fields: [nutricionistaId], references: [id], onDelete: Cascade)

  @@index([nutricionistaId])
  @@map("sessoes")
}

model ResetSenha {
  id              String        @id @default(uuid()) @db.Uuid
  nutricionistaId String        @map("nutricionista_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash")
  expiraEm        DateTime      @map("expira_em")
  usadoEm         DateTime?     @map("usado_em")
  criadoEm        DateTime      @default(now()) @map("criado_em")
  atualizadoEm    DateTime      @updatedAt @map("atualizado_em")
  nutricionista   Nutricionista @relation(fields: [nutricionistaId], references: [id], onDelete: Cascade)

  @@index([nutricionistaId])
  @@map("reset_senha")
}

model Paciente {
  id              String         @id @default(uuid()) @db.Uuid
  cpf             String?
  nutricionistaId String         @map("nutricionista_id") @db.Uuid
  nome            String
  dataNascimento  DateTime       @map("data_nascimento") @db.Date
  sexo            Sexo
  contato         String
  email           String?
  telefone        String?
  anamnese        String?
  arquivadoEm     DateTime?      @map("arquivado_em")
  status          StatusPaciente @default(ativo)
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @updatedAt @map("atualizado_em")
  nutricionista   Nutricionista  @relation(fields: [nutricionistaId], references: [id])
  medicoes        Medicao[]
  planos          Plano[]
  agendamentos    Agendamento[]

  @@unique([nutricionistaId, cpf])
  @@map("pacientes")
}

model Medicao {
  id              String        @id @default(uuid()) @db.Uuid
  pacienteId      String        @map("paciente_id") @db.Uuid
  data            DateTime      @db.Date
  pesoKg          Decimal       @map("peso_kg") @db.Decimal(8, 2)
  alturaCm        Decimal       @map("altura_cm") @db.Decimal(8, 2)
  circunferencias Json?
  nivelAtividade  String        @map("nivel_atividade")
  tmbKcal         Decimal       @map("tmb_kcal") @db.Decimal(10, 2)
  getKcal         Decimal       @map("get_kcal") @db.Decimal(10, 2)
  imc             Decimal       @db.Decimal(8, 2)
  formulaUsada    FormulaPadrao @map("formula_usada")
  fatorUsado      Decimal       @map("fator_usado") @db.Decimal(5, 3)
  criadoEm        DateTime      @default(now()) @map("criado_em")
  atualizadoEm    DateTime      @updatedAt @map("atualizado_em")
  paciente        Paciente      @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
  @@map("medicoes")
}

model Alimento {
  id                 String              @id @default(uuid()) @db.Uuid
  fonte              FonteAlimento
  idExterno          String?             @map("id_externo")
  nome               String
  nomeBusca          String              @map("nome_busca")
  grupo              String?
  porcaoReferencia   Int?                @map("porcao_referencia")
  energiaKcal        Decimal?            @map("energia_kcal") @db.Decimal(10, 2)
  proteinaG          Decimal?            @map("proteina_g") @db.Decimal(10, 2)
  lipidiosG          Decimal?            @map("lipidio_g") @db.Decimal(10, 2)
  carboidratoG       Decimal?            @map("carboidrato_g") @db.Decimal(10, 2)
  fibraG             Decimal?            @map("fibra_g") @db.Decimal(10, 2)
  sodioMg            Decimal?            @map("sodio_mg") @db.Decimal(10, 2)
  outros             Json?
  criadoEm           DateTime            @default(now()) @map("criado_em")
  atualizadoEm       DateTime            @updatedAt @map("atualizado_em")
  medidas            MedidaCaseira[]
  itensRefeicao      ItemRefeicao[]
  itensRefeicaoPlano ItemRefeicaoPlano[]

  criadoPor     String?        @map("criado_por") @db.Uuid
  nutricionista Nutricionista? @relation(fields: [criadoPor], references: [id], onDelete: SetNull)

  @@unique([fonte, idExterno])
  @@index([nomeBusca])
  @@map("alimentos")
}

model MedidaCaseira {
  id                 String              @id @default(uuid()) @db.Uuid
  alimentoId         String              @map("alimento_id") @db.Uuid
  descricao          String
  gramas             Decimal             @db.Decimal(8, 2)
  criadoEm           DateTime            @default(now()) @map("criado_em")
  atualizadoEm       DateTime            @updatedAt @map("atualizado_em")
  alimento           Alimento            @relation(fields: [alimentoId], references: [id], onDelete: Cascade)
  itensPlano         ItemRefeicao[]
  itemRefeicaoPlanos ItemRefeicaoPlano[]

  @@index([alimentoId])
  @@map("medidas_caseiras")
}

model Plano {
  id             String          @id @default(uuid()) @db.Uuid
  pacienteId     String          @map("paciente_id") @db.Uuid
  nome           String
  metaKcal       Decimal?        @map("meta_kcal") @db.Decimal(10, 2)
  versaoDe       String?         @map("versao_de") @db.Uuid
  criadoEm       DateTime        @default(now()) @map("criado_em")
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em")
  paciente       Paciente        @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  origem         Plano?          @relation("Versoes", fields: [versaoDe], references: [id])
  versoes        Plano[]         @relation("Versoes")
  refeicaoPlanos RefeicaoPlano[]

  @@index([pacienteId])
  @@map("planos")
}

model Refeicao {
  id        String       @id @default(uuid()) @db.Uuid
  nome      String
  descricao String?
  tipo      TipoRefeicao

  porcaoGramas Decimal? @map("porcao_gramas") @db.Decimal(8, 2)

  energiaKcal  Decimal? @map("energia_kcal") @db.Decimal(10, 2)
  proteinaG    Decimal? @map("proteina_g") @db.Decimal(10, 2)
  lipidiosG    Decimal? @map("lipidio_g") @db.Decimal(10, 2)
  carboidratoG Decimal? @map("carboidrato_g") @db.Decimal(10, 2)
  fibraG       Decimal? @map("fibra_g") @db.Decimal(10, 2)
  sodioMg      Decimal? @map("sodio_mg") @db.Decimal(10, 2)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  itens  ItemRefeicao[]
  planos RefeicaoPlano[]

  criadoPor     String?        @map("criado_por") @db.Uuid
  nutricionista Nutricionista? @relation(fields: [criadoPor], references: [id], onDelete: SetNull)

  @@index([criadoPor])
  @@map("refeicoes")
}

model RefeicaoPlano {
  id         String  @id @default(uuid()) @db.Uuid
  planoId    String  @map("plano_id") @db.Uuid
  refeicaoId String? @map("refeicao_id") @db.Uuid

  nome      String
  descricao String?
  tipo      TipoRefeicao
  categoria CategoriaRefeicao
  horario   String?
  ordem     Int               @default(0)

  porcaoGramas Decimal? @map("porcao_gramas") @db.Decimal(8, 2)

  energiaKcal  Decimal? @map("energia_kcal") @db.Decimal(10, 2)
  proteinaG    Decimal? @map("proteina_g") @db.Decimal(10, 2)
  lipidiosG    Decimal? @map("lipidio_g") @db.Decimal(10, 2)
  carboidratoG Decimal? @map("carboidrato_g") @db.Decimal(10, 2)
  fibraG       Decimal? @map("fibra_g") @db.Decimal(10, 2)
  sodioMg      Decimal? @map("sodio_mg") @db.Decimal(10, 2)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  plano    Plano               @relation(fields: [planoId], references: [id], onDelete: Cascade)
  refeicao Refeicao?           @relation(fields: [refeicaoId], references: [id], onDelete: SetNull)
  itens    ItemRefeicaoPlano[]

  @@index([planoId, ordem])
  @@index([refeicaoId])
  @@map("refeicoes_planos")
}

model ItemRefeicaoPlano {
  id              String  @id @default(uuid()) @db.Uuid
  refeicaoPlanoId String  @map("refeicao_plano_id") @db.Uuid
  alimentoId      String? @map("alimento_id") @db.Uuid

  alimentoNome     String   @map("alimento_nome")
  gramas           Decimal  @db.Decimal(8, 2)
  medidaId         String?  @map("medida_id") @db.Uuid
  medidaDescricao  String?  @map("medida_descricao")
  quantidadeMedida Decimal? @map("quantidade_medida") @db.Decimal(8, 2)
  ordem            Int

  // Valores nutricionais correspondentes à quantidade de gramas do item.
  energiaKcal  Decimal? @map("energia_kcal") @db.Decimal(10, 2)
  proteinaG    Decimal? @map("proteina_g") @db.Decimal(10, 2)
  lipidiosG    Decimal? @map("lipidio_g") @db.Decimal(10, 2)
  carboidratoG Decimal? @map("carboidrato_g") @db.Decimal(10, 2)
  fibraG       Decimal? @map("fibra_g") @db.Decimal(10, 2)
  sodioMg      Decimal? @map("sodio_mg") @db.Decimal(10, 2)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  refeicaoPlano RefeicaoPlano  @relation(fields: [refeicaoPlanoId], references: [id], onDelete: Cascade)
  alimento      Alimento?      @relation(fields: [alimentoId], references: [id], onDelete: SetNull)
  medida        MedidaCaseira? @relation(fields: [medidaId], references: [id], onDelete: SetNull)

  @@index([refeicaoPlanoId, ordem])
  @@index([alimentoId])
  @@index([medidaId])
  @@map("itens_refeicoes_planos")
}

model ItemRefeicao {
  id               String   @id @default(uuid()) @db.Uuid
  nome             String
  refeicaoId       String   @map("refeicao_id") @db.Uuid
  alimentoId       String   @map("alimento_id") @db.Uuid
  porcaoReferencia Int      @default(100) @map("porcao_referencia")
  gramas           Decimal  @db.Decimal(8, 2)
  medidaId         String?  @map("medida_id") @db.Uuid
  quantidadeMedida Decimal? @map("quantidade_medida") @db.Decimal(8, 2)
  ordem            Int

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  refeicao Refeicao       @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)
  alimento Alimento       @relation(fields: [alimentoId], references: [id])
  medida   MedidaCaseira? @relation(fields: [medidaId], references: [id], onDelete: SetNull)

  @@index([refeicaoId, ordem])
  @@index([alimentoId])
  @@index([medidaId])
  @@map("itens_refeicao")
}

model Consentimento {
  id              String        @id @default(uuid()) @db.Uuid
  nutricionistaId String        @map("nutricionista_id") @db.Uuid
  versaoTermo     String        @map("versao_termo")
  aceitoEm        DateTime      @map("aceito_em")
  ip              String
  criadoEm        DateTime      @default(now()) @map("criado_em")
  nutricionista   Nutricionista @relation(fields: [nutricionistaId], references: [id])

  @@index([nutricionistaId, versaoTermo])
  @@map("consentimentos")
}

model AuditoriaAcesso {
  id              String        @id @default(uuid()) @db.Uuid
  nutricionistaId String        @map("nutricionista_id") @db.Uuid
  acao            String
  entidade        String
  entidadeId      String        @map("entidade_id") @db.Uuid
  ocorridoEm      DateTime      @default(now()) @map("ocorrido_em")
  criadoEm        DateTime      @default(now()) @map("criado_em")
  nutricionista   Nutricionista @relation(fields: [nutricionistaId], references: [id])

  @@index([nutricionistaId])
  @@index([entidadeId])
  @@index([ocorridoEm])
  @@map("auditoria_acessos")
}

model Agendamento {
  id              String @id @default(uuid()) @db.Uuid
  nutricionistaId String @map("nutricionista_id") @db.Uuid

  // opcional para permitir agendar sem criar paciente
  pacienteId String? @map("paciente_id") @db.Uuid

  // dados minimos para agendar
  pacienteNome String @map("paciente_nome")
  contato      String @map("paciente_contato")

  data    DateTime @db.Date
  horario String   @db.VarChar(5) // HH:mm
  duracao Int      @db.SmallInt

  atendimento   Atendimentos      @map("atendimento")
  tipoConsulta  TiposConsulta     @map("tipo_consulta")
  local         Locais            @map("local")
  observacao    String?
  status        StatusAgendamento @default(aguardando_confirmacao)
  criadoEm      DateTime          @default(now()) @map("criado_em")
  atualizadoEm  DateTime          @updatedAt @map("atualizado_em")
  nutricionista Nutricionista     @relation(fields: [nutricionistaId], references: [id])
  paciente      Paciente?         @relation(fields: [pacienteId], references: [id])

  @@index([nutricionistaId, data])
  @@index([pacienteId])
  @@map("agendamentos")
}
